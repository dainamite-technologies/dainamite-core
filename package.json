{
  "name": "dainamite-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node ./scripts/setup.mjs",
    "setup:classic": "node ./scripts/setup.mjs --classic",
    "setup:reinstall": "node ./scripts/setup.mjs --reinstall",
    "setup:reinstall:classic": "node ./scripts/setup.mjs --reinstall --classic",
    "dev": "node ./scripts/dev-with-cpq-watch.mjs",
    "dev:bare": "node ./scripts/dev.mjs",
    "dev:classic": "node ./scripts/dev-with-cpq-watch.mjs --classic",
    "dev:verbose": "node ./scripts/dev-with-cpq-watch.mjs --verbose",
    "cpq:watch": "yarn workspace @dainamite/cpq watch",
    "billing:watch": "yarn workspace @dainamite/billing watch",
    "cpq-billing-connector:watch": "yarn workspace @dainamite/cpq-billing-connector watch",
    "build": "yarn generate && next build",
    "start": "mercato server start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:integration": "npx playwright test --config .ai/qa/tests/playwright.config.ts",
    "test:integration:ephemeral": "mercato test:integration",
    "generate": "mercato generate",
    "db:generate": "mercato db generate",
    "db:migrate": "mercato db migrate",
    "db:greenfield": "mercato db greenfield",
    "initialize": "mercato init",
    "dainamite-cpq-test": "mercato cpq seed",
    "dainamite-billing-test": "mercato billing seed",
    "dainamite-test": "mercato cpq seed && mercato billing seed",
    "reinstall": "mercato init --reinstall",
    "preinstall": "node -e \"const v = process.versions.node.split('.').map(Number); if (v[0] < 24) { console.error('Node >= 24 required'); process.exit(1); }\""
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.2",
