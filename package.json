    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.1",
    "react-email": "^5.0.6",
    "react-is": "^19.2.1",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.5.2",
    "sanitize-html": "^2.17.5",
    "semver": "^7.7.3",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.7",
    "jest": "^30.2.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.6",
    "ts-morph": "^25.0.0",
    "tsx": "^4.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.5.0",
    "bullmq": "^5.34.8",
    "ioredis": "^5.8.2"
  },
  "resolutions": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "zod": "4.4.3"
  },
  "imports": {
    "#generated/entities.ids.generated": {
      "types": "./.mercato/generated/entities.ids.generated.ts",
      "default": "./.mercato/generated/entities.ids.generated.mjs"
    },
    "#generated/entity-fields-registry": {
      "types": "./.mercato/generated/entity-fields-registry.ts",
      "default": "./.mercato/generated/entity-fields-registry.ts"
    },
    "#generated/entities/*": {
      "types": "./.mercato/generated/entities/*/index.ts",
      "default": "./.mercato/generated/entities/*/index.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
